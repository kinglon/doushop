// return: 0 not ready, 1 ready
function pay_check_ready() 
{
	if (document.getElementsByClassName('index_downloading__350ru').length > 0) 
	{
		return '1'
	}
	
	buttons = document.getElementsByClassName('index_export__2Z_pV')
	for (i=0; i<buttons.length; i++)
	{
		spans = buttons[i].getElementsByTagName('span')
		for (j=0; j<spans.length; j++)
		{
			if (spans[j].textContent == '导出明细')
			{				
				buttons[i].click()
				break
			}
		}
	}
	
	return '0'
}

var jsResult = {};
jsResult['fun'] = 'check_ready';
jsResult['ready'] = pay_check_ready()
jsResult